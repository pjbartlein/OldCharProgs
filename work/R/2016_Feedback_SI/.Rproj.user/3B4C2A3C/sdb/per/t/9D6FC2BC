    "contents" : "---\ntitle: \"Charcoal vs. temperature\"\noutput:\n  html_document:\n    css: SI-md-08.css\n    fig_caption: yes\n    highlight: haddock\n    number_sections: yes\n    theme: united\n    toc: yes\n    toc_float: false\n    collapsed: no\n---\n```{r smooth-curve, echo=FALSE}\noptions(width = 105)\nknitr::opts_chunk$set(dev='png', dpi=300, cache=FALSE)\npdf.options(useDingbats = TRUE)\n```\n\n# Introduction #\n\n## Read data ##\n\n```{r}\n# filenames\ndatapath <- \"e:/Projects/GPWG/work/feedback/data/\"\nchar_file <- paste(datapath, \"GCDv3i/\", \"v3i_nsa_globe_locfit_zt2kb_bw10_hw050_200.csv\", sep=\"\")\nchar_label <- \"Z-Scores (lwr, hw=50)\"\ntmp_file <- paste(datapath, \"Mann_etal_tmp/\", \"aaves_tmp_land_lwrboot_hw050_200.csv\", sep=\"\")\ntmp_label <- \"Mann et al. temp. (land) (lwr, hw=50)\"\n```\n\n```{r, results=\"hide\"}\n# read data\nchar_data <- read.csv(char_file); names(char_data)\ntmp_data <- read.csv(tmp_file); names(tmp_data)\n```\n\n```{r}\n# merge data\ndata_all <- as.data.frame(matrix(NA, nrow=46, ncol=4))\nnames(data_all) <- c(\"age\", \"YearCE\", \"char\", \"tmp\")\ndata_all[1] <- char_data[1]\ndata_all[2] <- 1950-data_all[1]\ndata_all[3] <- char_data[2]\ndata_all$tmp[1:dim(tmp_data)[1]] <- tmp_data[1:dim(tmp_data)[1], 3]\ndata_all <- data_all[1:41, ]\nprint(data_all)\n```\n\n```{r}\n# remove observations with missing temperature data\ndata_all <- na.exclude(data_all)\n```\n\n## Scatter plots ##\n\n```{r, fig.asp=1.0, fig.width=5}\nattach(data_all)\nplot(tmp, char, pch=16, cex=0.5, xlim=c(-.6, .7), ylim=c(-.3,.5), xlab=tmp_label, ylab=char_label)\ntext(tmp, char, lab=YearCE, cex=0.7, pos=1)\ndetach(data_all)\n```\n\n## Pre-industrial era data ##\n\n```{r}\ndata_preind <- data_all[data_all$YearCE <= 1700, ]\nprint(data_preind)\n```\n\n```{r, fig.asp=1.0, fig.width=5}\nattach(data_preind)\nplot(tmp, char, pch=16, cex=0.5, xlim=c(-.6, .1), ylim=c(-.2, .1), xlab=tmp_label, ylab=char_label)\ntext(tmp, char, lab=YearCE, cex=0.7, pos=1)\ndetach(data_preind)\n```\n\n# Regression #\n\n```{r}\nchar_lm01 <- lm(char ~ tmp, data=data_preind)\nsummary(char_lm01)\n```\n\n```{r, fig.asp=1.0, fig.width=6}\noldpar <- par(mfcol=c(2,2))\nplot(char_lm01, which=c(1,2,4))\nacf(char_lm01$residuals, main=\"ACF of residuals\", font.main=1)\npar <- oldpar\n```\n\n```{r, fig.asp=1.0, fig.width=5}\nattach(data_preind)\nplot(tmp, char, pch=16, cex=0.5, xlim=c(-.5, .2), ylim=c(-.2, .1), xlab=tmp_label, ylab=char_label)\ntext(tmp, char, lab=YearCE, cex=0.7, pos=1)\nabline(char_lm01, col=\"red\")\ndetach(data_preind)\n```\n",
