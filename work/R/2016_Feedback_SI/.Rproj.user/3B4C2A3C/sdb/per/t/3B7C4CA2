    "contents" : "---\ntitle: \"Untitled\"\noutput: html_document\n---\n\n```{r setup, include=FALSE}\nknitr::opts_chunk$set(echo = TRUE)\n```\n\n```{r}\n# filenames\ndatapath <- \"e:/Projects/GPWG/work/feedback/data/\"\nchar_file <- paste(datapath, \"GCDv3i/\", \"v3i_nsa_globe_binboot_nt2kb_pbw10_bw50_200.csv\", sep=\"\")\nd13C_file <- paste(datapath, \"d13C/\", \"NS_dc13_adjust_lwrboot_span_0.2_200.csv\", sep=\"\")\nCH4_file <- paste(datapath, \"CH4/\", \"law2006_CH4_lwrboot_span_0.1_200.csv\", sep=\"\")\nMann_file <- paste(datapath, \"Mann_etal_tmp/\", \"aaves_tmp_land_lwrboot_hw050_200.csv\", sep=\"\")\nPAGES2k_file <- paste(datapath, \"PAGES2k_tmp/\", \"PAGES2k_tave_lwrboot_hw050_200.csv\", sep=\"\")\n```\n\n```{r, results=\"hide\"}\n# read data\nchar_data <- read.csv(char_file); names(char_data)\nd13C_data <- read.csv(d13C_file); names(d13C_data)\nCH4_data <- read.csv(CH4_file); names(CH4_data)\nMann_data <- read.csv(Mann_file); names(Mann_data)\nPAGES2k_data <- read.csv(PAGES2k_file); names(PAGES2k_data)\n```\n\n```{r}\n# merge data\ndata_all <- as.data.frame(matrix(NA, nrow=46, ncol=7))\nnames(data_all) <- c(\"age\", \"YearCE\", \"char\", \"d13C\", \"CH4\", \"Mann_tmp\", \"PAGES2k_tmp\")\ndata_all[1:3] <- char_data[1:3]\ndata_all$d13C[1:dim(d13C_data)[1]] <- d13C_data[1:dim(d13C_data)[1], 3]\ndata_all$CH4[1:dim(CH4_data)[1]] <- CH4_data[1:dim(CH4_data)[1], 3]\ndata_all$Mann_tmp[1:dim(Mann_data)[1]] <- Mann_data[1:dim(Mann_data)[1], 3]\ndata_all$PAGES2k_tmp[1:dim(PAGES2k_data)[1]] <- PAGES2k_data[1:dim(PAGES2k_data)[1], 3]\ndata_all <- data_all[1:41, ]\n#print(data_all)\n```\n\n```{r}\ndata_short <- na.exclude(data_all)\n```\n\n```{r}\nattach(data_short)\nplot(Mann_tmp, char, pch=16, cex=0.5)\ntext(Mann_tmp, char, lab=YearCE, cex=0.7, pos=1)\ndetach(data_short)\n```\n\n```{r}\nattach(data_all)\nplot(PAGES2k_tmp, char, pch=16, cex=0.5)\ntext(PAGES2k_tmp, char, lab=YearCE, cex=0.7, pos=1)\ndetach(data_all)\n```\n```{r}\ndata_preind <- data_all[data_all$YearCE < 1750, ]\ndata_preind_short <- na.exclude(data_preind)\n```\n\n```{r}\nattach(data_preind_short)\nplot(Mann_tmp, char, pch=16, cex=0.5)\ntext(Mann_tmp, char, lab=YearCE, cex=0.7, pos=4)\ndetach(data_preind_short)\n```\n```{r}\nattach(data_preind)\nplot(PAGES2k_tmp, char, pch=16, cex=0.5)\ntext(PAGES2k_tmp, char, lab=YearCE, cex=0.7, pos=1)\ndetach(data_preind)\n```\n\n```{r, fig.asp=1, fig.width=6}\nattach(data_short)\nplot(PAGES2k_tmp, Mann_tmp, pch=16, cex=0.5, xlim=c(-.75,.75), ylim=c(-.75,.75))\ntext(PAGES2k_tmp, Mann_tmp, lab=YearCE, cex=0.7, pos=3)\ndetach(data_short)\n```",
