    "contents" : "---\ntitle: \"Charcoal vs. &delta;<sup>13</sup>C and CH<sub>4</sub>\"\noutput:\n  html_document:\n    css: SI-md-08.css\n    fig_caption: yes\n    highlight: haddock\n    number_sections: yes\n    theme: united\n    toc: yes\n    toc_float: false\n    collapsed: no\n---\n```{r smooth-curve, echo=FALSE}\noptions(width = 105)\nknitr::opts_chunk$set(dev='png', dpi=300, cache=FALSE)\npdf.options(useDingbats = TRUE)\n```\n\n# Introduciion #\n\n## Read data ##\n\n```{r}\n# filenames\ndatapath <- \"e:/Projects/GPWG/work/feedback/data/\"\nchar_file <- paste(datapath, \"GCDv3i/\", \"v3i_nsa_globe_binboot_zt2kb_pbw10_bw50_200.csv\", sep=\"\")\nchar_label <- \"Z-Scores (50-yr bins)\"\nd13C_file <- paste(datapath, \"d13C/\", \"NS_dc13_adjust_lwrboot_span_0.1_200.csv\", sep=\"\")\nd13C_label <- \"d13C (lwr, span=0.1)\"\nCH4_file <- paste(datapath, \"CH4/\", \"law2006_CH4_lwrboot_span_0.1_200.csv\", sep=\"\")\nCH4_label <- \"CH4 (lwr, span-0.1)\"\n```\n\n```{r, results=\"hide\"}\n# read data\nchar_data <- read.csv(char_file); names(char_data)\nd13C_data <- read.csv(d13C_file); names(d13C_data)\nCH4_data <- read.csv(CH4_file); names(CH4_data)\n```\n\n```{r}\n# merge data\ndata_all <- as.data.frame(matrix(NA, nrow=46, ncol=5))\nnames(data_all) <- c(\"age\", \"YearCE\", \"char\", \"d13C\", \"CH4\")\ndata_all[1:3] <- char_data[1:3]\ndata_all$d13C[1:dim(d13C_data)[1]] <- d13C_data[1:dim(d13C_data)[1], 3]\ndata_all$CH4[1:dim(CH4_data)[1]] <- CH4_data[1:dim(CH4_data)[1], 3]\ndata_all <- data_all[1:41, ]\nprint(data_all)\n```\n\n```{r}\n# remove observations with missing temperature data\ndata_all <- na.exclude(data_all)\n```\n\n\n## Pre-industrial era data ##\n\n```{r}\npreind <- data_all[data_all$YearCE < 1750, ]\nprint(preind)\n```\n\n## Scatter plots ##\n\n```{r}\n# function for plotting two series at a time\nplotseries <- function(title, dataset, xvarin, yvar1in, yvar2in) {\n  xvar <- dataset[,xvarin]\n  yvar1 <- dataset[,yvar1in]; yvar2 <- dataset[,yvar2in]\n  opar <- par(mar=c(5,4,4,5)+0.1) # space for second axis\n  plot(yvar1 ~ xvar, pch=16, xlab=xvarin, ylab=yvar1in, col=\"red\", data=dataset,\n    main=title)\n  par(new=T)          # second plot is going to get added to first\n  plot(yvar2 ~ xvar, xlab=\"\", pch=16, axes=F, ylab=\"\", col=\"blue\", data=dataset)\n  axis(side=4); mtext(side=4,line=3.8,yvar2in)\n  legend(\"bottomleft\", c(yvar1in,yvar2in), pch=16, col=c(\"red\",\"blue\"))\n  par(opar)  # restore plot parameters\n}\n```\n\n```{r}\nplotseries(\"global charcoal and (adjusted) northern & southern d13C\", preind, \n    \"YearCE\", \"char\", \"d13C\")\n```\n\n\n\n```{r, fig.asp=1.0, fig.width=5}\nplot(preind$d13C, preind$char, pch=16, cex=0.5, xlim=c(-49, -47), ylim=c(-.2,.1), xlab=d13C_label, ylab=char_label)\ntext(preind$d13C, preind$char, lab=preind$YearCE, cex=0.7, pos=1)\n```\n\n```{r}\nplotseries(\"global charcoal and CH4\", preind, \"YearCE\", \"char\", \"CH4\")\n```\n\n\n```{r, fig.asp=1.0, fig.width=5}\nplot(preind$CH4, preind$char, pch=16, cex=0.5, xlim=c(625, 700), ylim=c(-0.2, 0.1), xlab=d13C_label, ylab=char_label)\ntext(preind$CH4, preind$char, lab=preind$YearCE, cex=0.7, pos=1)\n```\n\n\n# Regression #\n\n```{r}\ncheck_lm01 <- lm(char ~ I(d13C * CH4) + CH4, data=preind)\nsummary(check_lm01)\n```\n\n```{r}\ncheck_lm01$coefficients\nratio <- check_lm01$coefficients[3]/check_lm01$coefficients[2]; names(ratio) <- \"ratio\"\nprint(ratio)\n```\n\n```{r, fig.asp=1.0, fig.width=6}\noldpar <- par(mfcol=c(2,2))\nplot(check_lm01, which=c(1,2,4))\nacf(check_lm01$residuals, main=\"ACF of residuals\", font.main=1)\npar <- oldpar\n```\n\n```{r}\nfitted <- data.frame(cbind(preind, check_lm01$residuals, check_lm01$fitted.values))\nplotseries(\"global charcoal and CH4\", fitted, \"YearCE\", \"char\", \"check_lm01.fitted.values\")\n```\n```{r}\nlibrary(visreg)\n```\n\nMore diagnostic analysis.\n\n```{r}\noldpar <- par(mfcol=c(1,2))\nvisreg(check_lm01, points=list(pch=16, cex=1))\npar <- oldpar\n```\n\n```{r, fig.asp=0.75, fig.width=5}\nvisreg2d(check_lm01, xvar=\"d13C\", yvar= \"CH4\")\n```\n\n\n\n",
